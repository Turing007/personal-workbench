# Caddy 配置：自动申请并续期 Let's Encrypt 证书。
# 域名来自 docker-compose 注入的 WORKBENCH_DOMAIN 环境变量，可以写多个（逗号分隔），
# 例如 vigortech.xyz, www.vigortech.xyz —— Caddy 会给整块里的所有名字签同一张证书，
# 所以每个名字都必须解析到本机，否则整张证书都会签不下来。
# 如需接收证书到期提醒，可在此文件顶部添加：{ email your@example.com }
{$WORKBENCH_DOMAIN} {
	reverse_proxy workbench:52341
	encode gzip zstd
}

# DSH Remote 自建中转站：独立子域，后端是同一 Docker 网络里的 dsh-remote-server。
# 不要删除这个站点块，否则工作台下次部署后 dsh.vigortech.xyz 会 502。
dsh.vigortech.xyz {
	encode zstd gzip
	reverse_proxy dsh-remote-server:8080 {
		flush_interval -1
		header_up X-Forwarded-For {remote_host}
	}
}
